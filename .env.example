# JANUS server configuration example
# Copy values into the deployment environment; do not commit real secrets.

OPENAI_API_KEY=
JANUS_DB_PATH=/data/janus.sqlite3
JANUS_FILE_DIR=/data/files

# Core wake/rest cadence. Recursive wake processing is deterministic and makes
# zero external model/API calls; rest remains passive.
JANUS_WAKE_SECONDS=300
JANUS_SLEEP_SECONDS=600
JANUS_V2_BACKGROUND_TICK_SECONDS=300

# Continuing digital observation / research.
JANUS_CURIOSITY_WEB=1
JANUS_CURIOSITY_MIN_GAP_SECONDS=1200

# Owner-set default research budget. Do not raise these defaults without an
# explicit owner decision. Both autonomous and user-directed web research share
# the same persistent monthly ledger.
JANUS_RESEARCH_MONTHLY_MAX_USD=20
JANUS_AUTONOMOUS_RESEARCH_TARGET_USD=10
JANUS_RESEARCH_ESTIMATED_USD_PER_CALL=0.01
JANUS_CURIOSITY_DAILY_SEARCH_CAP=40

# Foreground and background call safety caps.
JANUS_FOREGROUND_DAILY_CALL_CAP=500
JANUS_BACKGROUND_DAILY_CALL_CAP=12
JANUS_BACKGROUND_DAILY_TOKEN_CAP=20000
JANUS_IMAGE_DAILY_CAP=20

# Existing JANUS foreground web capability.
JANUS_FOREGROUND_WEB=1

# Image generation remains bounded; multi-core background image generation is off.
JANUS_IMAGE_MODEL=gpt-image-1-mini
JANUS_IMAGE_QUALITY=medium
JANUS_IMAGE_SIZE=1024x1024
JANUS_IMAGE_DAILY_USER_CAP=6
JANUS_IMAGE_DAILY_AUTO_CAP=1
JANUS_IMAGE_GLOBAL_DAILY_CAP=100
JANUS_IMAGE_GLOBAL_AUTO_DAILY_CAP=20
JANUS_IMAGE_AUTO_COOLDOWN_HOURS=18
JANUS_BACKGROUND_MULTI_CORE_IMAGES=0

# Audio attachment transcription (foreground/user-selected media only).
JANUS_AUDIO_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# Maintenance remains owner/Supervisor governed.
JANUS_MAINTENANCE_OWNER_PROFILE=
JANUS_MESSAGE_QUEUE=1

# Authentication / identity provider values belong in deployment secrets.
JANUS_GOOGLE_WEB_CLIENT_ID=
JANUS_GOOGLE_ANDROID_CLIENT_ID=
JANUS_APPLE_CLIENT_ID=
JANUS_SESSION_SECRET=
JANUS_EMAIL_FROM=
JANUS_SMTP_HOST=
JANUS_SMTP_PORT=587
JANUS_SMTP_USERNAME=
JANUS_SMTP_PASSWORD=

# Render / deployment identity, where supplied by the platform.
JANUS_DEPLOYED_COMMIT=
