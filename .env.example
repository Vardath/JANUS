OPENAI_API_KEY=your_api_key_here
JANUS_MODEL=gpt-5.6
JANUS_INTERVAL_MINUTES=15
JANUS_DB_PATH=/data/janus.sqlite3
JANUS_ACCESS_TOKEN=replace-with-a-long-random-secret
JANUS_DB_MAX_MB=256
JANUS_MEMORY_CAP_GLOBAL=3000
JANUS_MEMORY_CAP_PER_USER=2000
JANUS_EVENT_CAP_PER_USER=5000
JANUS_BRIDGE_CAP_PER_USER=5000
JANUS_DORMANCY_PERCENT=67
JANUS_THOUGHT_COUNT=1
JANUS_MEMORY_PROCESSING=1
JANUS_SELF_EVALUATION=0
JANUS_EXTERNAL_ACCESS=1
JANUS_SUPERVISOR_CONSULTATION=0
JANUS_MESSAGE_QUEUE=1
JANUS_THOUGHT_HISTORY=1
JANUS_COMPUTE_BUDGET=balanced
JANUS_UNRESOLVED_CAP=200
JANUS_NOVELTY_ESCALATION_THRESHOLD=0.58
JANUS_CORE_RELIABILITY_FLOOR=0.20
JANUS_SESSION_DAYS=30
JANUS_GOOGLE_CLIENT_ID=
JANUS_APPLE_CLIENT_IDS=
JANUS_ALLOW_LEGACY_BRIDGE_AUTH=0
JANUS_AUTH_BASE_URL=
JANUS_SMTP_HOST=
JANUS_SMTP_PORT=587
JANUS_SMTP_USER=
JANUS_SMTP_PASSWORD=
JANUS_SMTP_FROM=
JANUS_SMTP_TLS=1
JANUS_MAINTENANCE_OWNER_EMAIL=
JANUS_MAINTENANCE_OWNER_PROFILE=
JANUS_RESEARCH_OWNER_PROFILE=
JANUS_MAINTENANCE_INTERVAL_DAYS=90
JANUS_MAINTENANCE_CHECK_SECONDS=21600

# Optional private Supervisor visibility mirror. Canonical maintenance state remains on
# Render SQLite + the append-only JSONL ledger. Use a fine-grained GitHub token limited
# to Vardath/JANUS-privatebuild with Issues read/write only and NO Contents/code write.
# Existing open requests are backfilled once when this is enabled.
JANUS_MAINTENANCE_GITHUB_MIRROR=0
JANUS_MAINTENANCE_GITHUB_REPO=Vardath/JANUS-privatebuild
JANUS_MAINTENANCE_GITHUB_ISSUE=1
JANUS_MAINTENANCE_GITHUB_TOKEN=

JANUS_AUTH_DEV_TOKENS=0
JANUS_PAID_BACKGROUND_REFLECTION=0
JANUS_BACKGROUND_DAILY_CALL_CAP=8
JANUS_BACKGROUND_DAILY_TOKEN_CAP=16000

# Continuing digital observation. Wake/review and curiosity-intent formation remain
# zero-model/API; only selected external observations consume this allowance.
JANUS_CURIOSITY_WEB=1
JANUS_CURIOSITY_DAILY_SEARCH_CAP=40
JANUS_CURIOSITY_RELEVANT_DAILY_CAP=2
JANUS_CURIOSITY_ADJACENT_DAILY_CAP=1
JANUS_CURIOSITY_WANDER_DAILY_CAP=1
JANUS_CURIOSITY_MIN_GAP_SECONDS=1200
JANUS_CURIOSITY_MODEL=gpt-5.6

# Owner-set shared web-research budget. Autonomous/background research is capped at
# $10/month inside a $20/month total; the remainder is reserved for user-directed web.
# Do not raise these defaults without an explicit owner decision. The per-call figure
# is a planning estimate and should be raised during maintenance if provider pricing
# or token overhead makes real calls cost more.
JANUS_RESEARCH_MONTHLY_MAX_USD=20
JANUS_AUTONOMOUS_RESEARCH_TARGET_USD=10
JANUS_RESEARCH_ESTIMATED_USD_PER_CALL=0.01

JANUS_CHAT_RECEIPT_RETENTION_DAYS=7
JANUS_RUNTIME_SNAPSHOT_RETENTION_DAYS=30
JANUS_REMOTE_DEVICE_CAP=100
JANUS_VISION_MODEL=gpt-5.6-luna
JANUS_VISION_DETAIL=low
JANUS_VISION_MAX_IMAGES_PER_TURN=4
JANUS_VISION_ACCOUNT_DAILY_CAP=12
JANUS_VISION_GLOBAL_DAILY_CAP=200
JANUS_VISION_ASSESSMENT_CHARS=3500
JANUS_MAX_PDF_TEXT_CHARS=250000
JANUS_MAX_PDF_PAGES=80
